{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/Dockerfile.static",
    "watchPatterns": [
      "apps/miniapp/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "infra/Dockerfile.static",
      "infra/Caddyfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    },
    "healthcheckPath": "/health"
  }
}
