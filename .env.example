# Скопируйте в .env для локального запуска. На Railway те же переменные задаются в настройках сервисов.
# Сгенерировать секреты: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
MINIAPP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dominify
REDIS_URL=redis://localhost:6379

# ── Telegram ──
# Токен от @BotFather. Для разработки заведите отдельного тестового бота.
BOT_TOKEN=
BOT_USERNAME=dominify_bot
MINIAPP_SHORT_NAME=app
# polling — локально; webhook — на Railway (нужны BOT_PUBLIC_URL и BOT_WEBHOOK_SECRET)
BOT_MODE=polling
BOT_PUBLIC_URL=
BOT_WEBHOOK_SECRET=
# telegram — слать сообщения; log — только писать в лог
NOTIFY_DRIVER=telegram

# ── Безопасность ──
JWT_SECRET=change-me-at-least-32-characters-long-secret
# 32 байта в base64 (AES-256-GCM для телефонов и ИНН). Потеря ключа = потеря зашифрованных данных.
ENCRYPTION_KEY=
HASH_KEY=change-me-hash-key
# Telegram ID основателей: получают доступ к админке при первом входе
ADMIN_TELEGRAM_IDS=
# Вход без Telegram (?dev=<id> в Mini App). Только локально, в production запрещён.
DEV_AUTH=1

# ── ИИ ──
# rules — разбор без ИИ (бесплатно, для разработки); gemini — Google Gemini; anthropic — Claude
LLM_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_SMART=gemini-3.1-pro-preview
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-sonnet-5
LLM_CONFIDENCE_THRESHOLD=0.7
AI_DAILY_PARSE_LIMIT_PER_USER=40
# Распознавание голосовых: любой OpenAI-совместимый /audio/transcriptions
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ── Файлы ──
# local — папка на диске; s3 — Storage bucket Railway
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Оплата счетов (веб-страница счёта, не Mini App) ──
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
BANK_REQUISITES=

# ── Правила маркетплейса ──
QUIET_HOURS_START=22
QUIET_HOURS_END=8
REQUEST_TTL_DAYS=7
WAVE1_WAIT_MIN=30
OFFER_DIGEST_MIN=10
SUPPLIER_REMIND_MIN=60
