{
  "name": "@dominify/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:api": "node dist/main.api.js",
    "start:bot": "node dist/main.bot.js",
    "start:worker": "node dist/main.worker.js",
    "dev:api": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.api.js\"",
    "dev:bot": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.bot.js\"",
    "dev:worker": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.worker.js\"",
    "e2e": "node dist/e2e/run.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@dominify/db": "workspace:*",
    "@dominify/shared": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "@sentry/node": "^9.47.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.44.7",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "tsc-watch": "^7.2.1"
  }
}
